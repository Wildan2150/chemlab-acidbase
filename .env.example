# Salin ke .env.local dan isi konfigurasi Web App dari Firebase Console.
# Aktifkan Authentication > Email/Password dan atur Authorized domains.
# Konfigurasi client VITE_* terlihat oleh browser; jangan isi kredensial admin.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_USE_EMULATOR=false
